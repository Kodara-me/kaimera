{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Kaimera",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build", "--target", "kaimera"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
